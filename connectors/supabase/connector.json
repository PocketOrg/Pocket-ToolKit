{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "supabase",
  "summary": "Manage Supabase projects: query Postgres, inspect auth users and storage. Use for Supabase-backed apps.",
  "category": "Data & Analytics",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@supabase/mcp-server-supabase"
    ]
  },
  "auth": "apiKey",
  "scopes": [
    "read",
    "write"
  ],
  "tools": [
    {
      "name": "execute_sql",
      "description": "Runs SQL against the project database.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The SQL to run."
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "list_tables",
      "description": "Lists tables with their schemas.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "readOnly": true
    },
    {
      "name": "apply_migration",
      "description": "Applies a named DDL migration.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Migration name."
          },
          "query": {
            "type": "string",
            "description": "DDL to apply."
          }
        },
        "required": [
          "name",
          "query"
        ]
      }
    }
  ],
  "license": "MIT",
  "homepage": "https://supabase.com"
}
