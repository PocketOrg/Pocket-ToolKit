{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "stripe",
  "summary": "Inspect Stripe customers, subscriptions, payments and disputes. Use for billing questions and revenue checks.",
  "category": "Sales & Marketing",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@stripe/mcp"
    ]
  },
  "auth": "apiKey",
  "scopes": [
    "read"
  ],
  "tools": [
    {
      "name": "list_customers",
      "description": "Lists customers, optionally filtered by email.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Filter to this email address."
          }
        },
        "required": []
      },
      "readOnly": true
    },
    {
      "name": "get_subscription",
      "description": "Returns a subscription with its items and status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "subscription_id": {
            "type": "string",
            "description": "Subscription id."
          }
        },
        "required": [
          "subscription_id"
        ]
      },
      "readOnly": true
    },
    {
      "name": "list_payments",
      "description": "Lists recent payment intents with status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Filter to one customer."
          }
        },
        "required": []
      },
      "readOnly": true
    },
    {
      "name": "create_refund",
      "description": "Refunds a charge, fully or partially.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "charge_id": {
            "type": "string",
            "description": "Charge id."
          },
          "amount": {
            "type": "number",
            "description": "Amount in the smallest currency unit."
          }
        },
        "required": [
          "charge_id"
        ]
      }
    }
  ],
  "license": "MIT",
  "homepage": "https://stripe.com"
}
