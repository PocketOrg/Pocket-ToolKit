{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "shopify",
  "summary": "Query Shopify store data and developer documentation. Use for order lookups, catalogue questions and storefront development.",
  "category": "Sales & Marketing",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@shopify/dev-mcp"
    ]
  },
  "auth": "apiKey",
  "scopes": [
    "read"
  ],
  "tools": [
    {
      "name": "search_docs",
      "description": "Searches Shopify developer documentation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search text."
          }
        },
        "required": [
          "query"
        ]
      },
      "readOnly": true
    },
    {
      "name": "introspect_admin_schema",
      "description": "Returns the Admin GraphQL schema for a type.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Type name to inspect."
          }
        },
        "required": []
      },
      "readOnly": true
    },
    {
      "name": "list_orders",
      "description": "Lists recent orders with status and total.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Filter by fulfilment status."
          },
          "limit": {
            "type": "number",
            "description": "Maximum orders."
          }
        },
        "required": []
      },
      "readOnly": true
    },
    {
      "name": "get_product",
      "description": "Returns a product with variants and inventory.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "Product identifier."
          }
        },
        "required": [
          "product_id"
        ]
      },
      "readOnly": true
    }
  ],
  "license": "MIT",
  "homepage": "https://shopify.com"
}
