{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "sqlite",
  "summary": "Query and inspect a local SQLite database. Use for analysis of a file-based dataset.",
  "category": "Data & Analytics",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-sqlite"
    ]
  },
  "auth": "none",
  "scopes": [],
  "tools": [
    {
      "name": "read_query",
      "description": "Runs a SELECT and returns rows.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "A SELECT statement."
          }
        },
        "required": [
          "query"
        ]
      },
      "readOnly": true
    },
    {
      "name": "write_query",
      "description": "Runs an INSERT, UPDATE or DELETE.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The statement to run."
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "list_tables",
      "description": "Lists every table in the database.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "readOnly": true
    }
  ],
  "license": "MIT",
  "homepage": "https://sqlite.org"
}
