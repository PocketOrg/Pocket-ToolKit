{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "jira",
  "summary": "Manage Jira issues, sprints and boards. Use for teams tracking work in Jira.",
  "category": "Documents & Communication",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "mcp-atlassian"
    ]
  },
  "auth": "apiKey",
  "scopes": [
    "read:jira-work",
    "write:jira-work"
  ],
  "tools": [
    {
      "name": "search_issues",
      "description": "Searches issues using JQL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "jql": {
            "type": "string",
            "description": "A JQL query."
          }
        },
        "required": [
          "jql"
        ]
      },
      "readOnly": true
    },
    {
      "name": "create_issue",
      "description": "Creates an issue in a project.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_key": {
            "type": "string",
            "description": "Project key."
          },
          "summary": {
            "type": "string",
            "description": "Issue summary."
          },
          "issue_type": {
            "type": "string",
            "description": "Bug, Task, Story."
          },
          "description": {
            "type": "string",
            "description": "Issue description."
          }
        },
        "required": [
          "project_key",
          "summary",
          "issue_type"
        ]
      }
    },
    {
      "name": "transition_issue",
      "description": "Moves an issue to a new workflow state.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "issue_key": {
            "type": "string",
            "description": "Issue key, e.g. ENG-42."
          },
          "transition": {
            "type": "string",
            "description": "Target state name."
          }
        },
        "required": [
          "issue_key",
          "transition"
        ]
      }
    }
  ],
  "license": "MIT",
  "homepage": "https://www.atlassian.com/software/jira"
}
