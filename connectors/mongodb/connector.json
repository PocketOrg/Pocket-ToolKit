{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "mongodb",
  "summary": "Query and inspect MongoDB collections. Use for document lookups, aggregation and schema exploration.",
  "category": "Data & Analytics",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "mongodb-mcp-server"
    ]
  },
  "auth": "apiKey",
  "scopes": [
    "read"
  ],
  "tools": [
    {
      "name": "list_collections",
      "description": "Lists collections in a database.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "description": "Database name."
          }
        },
        "required": [
          "database"
        ]
      },
      "readOnly": true
    },
    {
      "name": "find",
      "description": "Runs a find query against a collection.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection name."
          },
          "filter": {
            "type": "string",
            "description": "Query filter as JSON."
          },
          "limit": {
            "type": "number",
            "description": "Maximum documents."
          }
        },
        "required": [
          "collection"
        ]
      },
      "readOnly": true
    },
    {
      "name": "aggregate",
      "description": "Runs an aggregation pipeline.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection name."
          },
          "pipeline": {
            "type": "string",
            "description": "Pipeline stages as JSON array."
          }
        },
        "required": [
          "collection",
          "pipeline"
        ]
      },
      "readOnly": true
    },
    {
      "name": "get_indexes",
      "description": "Lists indexes on a collection.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection name."
          }
        },
        "required": [
          "collection"
        ]
      },
      "readOnly": true
    }
  ],
  "license": "MIT",
  "homepage": "https://mongodb.com"
}
