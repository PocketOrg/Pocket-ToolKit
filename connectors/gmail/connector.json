{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "gmail",
  "summary": "Search, read and send email through Gmail. Use for inbox triage and drafting replies.",
  "category": "Documents & Communication",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@gongrzhe/server-gmail-autoauth-mcp"
    ]
  },
  "auth": "oauth2",
  "scopes": [
    "gmail.readonly",
    "gmail.send"
  ],
  "tools": [
    {
      "name": "search_emails",
      "description": "Searches messages using Gmail query syntax.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "e.g. from:x is:unread."
          }
        },
        "required": [
          "query"
        ]
      },
      "readOnly": true
    },
    {
      "name": "read_email",
      "description": "Returns headers and body for one message.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "description": "Gmail message id."
          }
        },
        "required": [
          "message_id"
        ]
      },
      "readOnly": true
    },
    {
      "name": "send_email",
      "description": "Sends a message.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "Recipient address."
          },
          "subject": {
            "type": "string",
            "description": "Subject line."
          },
          "body": {
            "type": "string",
            "description": "Message body."
          }
        },
        "required": [
          "to",
          "subject",
          "body"
        ]
      }
    }
  ],
  "license": "MIT",
  "homepage": "https://mail.google.com"
}
