{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "sentry",
  "summary": "Inspect Sentry errors, stack traces and release health. Use when triaging a production exception.",
  "category": "Software Engineering",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@sentry/mcp-server"
    ]
  },
  "auth": "apiKey",
  "scopes": [
    "project:read",
    "event:read"
  ],
  "tools": [
    {
      "name": "list_issues",
      "description": "Lists unresolved issues for a project, most frequent first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organization_slug": {
            "type": "string",
            "description": "Organisation slug."
          },
          "project_slug": {
            "type": "string",
            "description": "Project slug."
          },
          "query": {
            "type": "string",
            "description": "Sentry search query, e.g. is:unresolved."
          }
        },
        "required": [
          "organization_slug",
          "project_slug"
        ]
      },
      "readOnly": true
    },
    {
      "name": "get_issue_details",
      "description": "Returns the full stack trace, breadcrumbs and tags for one issue.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "description": "Sentry issue id."
          }
        },
        "required": [
          "issue_id"
        ]
      },
      "readOnly": true
    },
    {
      "name": "resolve_issue",
      "description": "Marks an issue resolved.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "description": "Sentry issue id."
          }
        },
        "required": [
          "issue_id"
        ]
      }
    }
  ],
  "license": "MIT",
  "homepage": "https://sentry.io"
}
