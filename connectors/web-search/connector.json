{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "web-search",
  "summary": "Search the web and read pages. Use when the answer depends on current information rather than training data.",
  "category": "Research & Knowledge",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-brave-search"
    ]
  },
  "auth": "apiKey",
  "scopes": [
    "search"
  ],
  "tools": [
    {
      "name": "web_search",
      "description": "Searches the web and returns titles, URLs and snippets.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query."
          },
          "count": {
            "type": "number",
            "description": "Results to return. Defaults to 10."
          }
        },
        "required": [
          "query"
        ]
      },
      "readOnly": true
    }
  ],
  "license": "MIT"
}
