{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "notion",
  "summary": "Read and write Notion pages and databases. Use for specs, notes and structured project tracking.",
  "category": "Documents & Communication",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@notionhq/notion-mcp-server"
    ]
  },
  "auth": "oauth2",
  "scopes": [
    "read",
    "insert",
    "update"
  ],
  "tools": [
    {
      "name": "search",
      "description": "Searches pages and databases by title and content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search text."
          }
        },
        "required": [
          "query"
        ]
      },
      "readOnly": true
    },
    {
      "name": "get_page",
      "description": "Returns a page's properties and block content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "description": "Notion page id."
          }
        },
        "required": [
          "page_id"
        ]
      },
      "readOnly": true
    },
    {
      "name": "create_page",
      "description": "Creates a page in a parent page or database.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "parent_id": {
            "type": "string",
            "description": "Parent page or database id."
          },
          "title": {
            "type": "string",
            "description": "Page title."
          },
          "content": {
            "type": "string",
            "description": "Markdown content for the body."
          }
        },
        "required": [
          "parent_id",
          "title"
        ]
      }
    },
    {
      "name": "query_database",
      "description": "Queries a database with filters and sorts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "database_id": {
            "type": "string",
            "description": "Database id."
          },
          "filter": {
            "type": "object",
            "description": "Notion filter object."
          }
        },
        "required": [
          "database_id"
        ]
      },
      "readOnly": true
    }
  ],
  "license": "MIT",
  "homepage": "https://notion.so"
}
