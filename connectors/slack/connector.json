{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "slack",
  "summary": "Read and post Slack messages, and search channel history. Use for team updates and finding past decisions.",
  "category": "Documents & Communication",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-slack"
    ]
  },
  "auth": "oauth2",
  "scopes": [
    "channels:read",
    "chat:write",
    "search:read"
  ],
  "tools": [
    {
      "name": "list_channels",
      "description": "Lists channels the token can see.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "readOnly": true
    },
    {
      "name": "get_channel_history",
      "description": "Returns recent messages from a channel.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": {
            "type": "string",
            "description": "Channel id."
          },
          "limit": {
            "type": "number",
            "description": "Messages to return. Defaults to 50."
          }
        },
        "required": [
          "channel_id"
        ]
      },
      "readOnly": true
    },
    {
      "name": "post_message",
      "description": "Posts a message to a channel or thread.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": {
            "type": "string",
            "description": "Channel id."
          },
          "text": {
            "type": "string",
            "description": "Message text."
          },
          "thread_ts": {
            "type": "string",
            "description": "Reply in this thread rather than the channel."
          }
        },
        "required": [
          "channel_id",
          "text"
        ]
      }
    }
  ],
  "license": "MIT",
  "homepage": "https://slack.com"
}
