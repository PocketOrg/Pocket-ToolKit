{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "kubernetes",
  "summary": "Inspect Kubernetes workloads, pods, events and logs. Use when diagnosing a cluster or a failing deployment.",
  "category": "Cloud & DevOps",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "mcp-server-kubernetes"
    ]
  },
  "auth": "apiKey",
  "scopes": [
    "read"
  ],
  "tools": [
    {
      "name": "list_pods",
      "description": "Lists pods in a namespace with phase and restart counts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "description": "Namespace. Defaults to default."
          }
        },
        "required": []
      },
      "readOnly": true
    },
    {
      "name": "get_pod_logs",
      "description": "Returns logs for a pod, optionally for the previous instance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Pod name."
          },
          "namespace": {
            "type": "string",
            "description": "Namespace."
          },
          "previous": {
            "type": "boolean",
            "description": "Read the crashed instance's logs."
          }
        },
        "required": [
          "name"
        ]
      },
      "readOnly": true
    },
    {
      "name": "describe_resource",
      "description": "Returns full detail and recent events for a resource.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "Resource kind, e.g. deployment."
          },
          "name": {
            "type": "string",
            "description": "Resource name."
          },
          "namespace": {
            "type": "string",
            "description": "Namespace."
          }
        },
        "required": [
          "kind",
          "name"
        ]
      },
      "readOnly": true
    }
  ],
  "license": "MIT",
  "homepage": "https://kubernetes.io"
}
