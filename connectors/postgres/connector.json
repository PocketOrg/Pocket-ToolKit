{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "postgres",
  "summary": "Query PostgreSQL and inspect schemas. Use for analysis, debugging data problems, or checking a migration.",
  "category": "Data & Analytics",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-postgres"
    ]
  },
  "auth": "apiKey",
  "scopes": [
    "read"
  ],
  "tools": [
    {
      "name": "query",
      "description": "Runs a read-only SQL query and returns rows. Writes are rejected.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "description": "A SELECT statement."
          }
        },
        "required": [
          "sql"
        ]
      },
      "readOnly": true
    },
    {
      "name": "list_tables",
      "description": "Lists tables and views in a schema.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema name. Defaults to public."
          }
        },
        "required": []
      },
      "readOnly": true
    },
    {
      "name": "describe_table",
      "description": "Returns columns, types, indexes and constraints for one table.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string",
            "description": "Table name."
          }
        },
        "required": [
          "table"
        ]
      },
      "readOnly": true
    }
  ],
  "license": "MIT",
  "homepage": "https://www.postgresql.org"
}
