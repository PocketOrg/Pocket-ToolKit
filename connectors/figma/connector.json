{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "figma",
  "summary": "Read Figma files, frames and design tokens. Use when implementing a design or extracting styles.",
  "category": "Design & Creative",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "figma-developer-mcp"
    ]
  },
  "auth": "apiKey",
  "scopes": [
    "file_read"
  ],
  "tools": [
    {
      "name": "get_file",
      "description": "Returns a file's document tree, frames and components.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_key": {
            "type": "string",
            "description": "Figma file key."
          }
        },
        "required": [
          "file_key"
        ]
      },
      "readOnly": true
    },
    {
      "name": "get_node",
      "description": "Returns one node's properties, including layout and styles.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_key": {
            "type": "string",
            "description": "Figma file key."
          },
          "node_id": {
            "type": "string",
            "description": "Node id."
          }
        },
        "required": [
          "file_key",
          "node_id"
        ]
      },
      "readOnly": true
    },
    {
      "name": "get_image",
      "description": "Renders a node to an image URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_key": {
            "type": "string",
            "description": "Figma file key."
          },
          "node_id": {
            "type": "string",
            "description": "Node id."
          }
        },
        "required": [
          "file_key",
          "node_id"
        ]
      },
      "readOnly": true
    }
  ],
  "license": "MIT",
  "homepage": "https://figma.com"
}
