{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "filesystem",
  "summary": "Read, write and search files in an allowed directory. Use for working with a local project.",
  "category": "Tools & Automation",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-filesystem"
    ]
  },
  "auth": "none",
  "scopes": [],
  "tools": [
    {
      "name": "read_file",
      "description": "Reads a file's contents.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path."
          }
        },
        "required": [
          "path"
        ]
      },
      "readOnly": true
    },
    {
      "name": "write_file",
      "description": "Writes content to a file, creating or overwriting it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path."
          },
          "content": {
            "type": "string",
            "description": "Content to write."
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    {
      "name": "search_files",
      "description": "Searches file contents by pattern.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "description": "Search pattern."
          },
          "path": {
            "type": "string",
            "description": "Directory to search in."
          }
        },
        "required": [
          "pattern"
        ]
      },
      "readOnly": true
    },
    {
      "name": "list_directory",
      "description": "Lists entries in a directory.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Directory path."
          }
        },
        "required": [
          "path"
        ]
      },
      "readOnly": true
    }
  ],
  "license": "MIT"
}
