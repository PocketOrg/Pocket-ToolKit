{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "google-calendar",
  "summary": "Read and create Google Calendar events. Use for scheduling and checking availability.",
  "category": "Documents & Communication",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@cocal/google-calendar-mcp"
    ]
  },
  "auth": "oauth2",
  "scopes": [
    "calendar.events"
  ],
  "tools": [
    {
      "name": "list_events",
      "description": "Lists events in a time range.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "time_min": {
            "type": "string",
            "description": "ISO start."
          },
          "time_max": {
            "type": "string",
            "description": "ISO end."
          }
        },
        "required": [
          "time_min",
          "time_max"
        ]
      },
      "readOnly": true
    },
    {
      "name": "create_event",
      "description": "Creates an event with attendees.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "description": "Event title."
          },
          "start": {
            "type": "string",
            "description": "ISO start time."
          },
          "end": {
            "type": "string",
            "description": "ISO end time."
          },
          "attendees": {
            "type": "array",
            "description": "Attendee email addresses."
          }
        },
        "required": [
          "summary",
          "start",
          "end"
        ]
      }
    }
  ],
  "license": "MIT",
  "homepage": "https://calendar.google.com"
}
