{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "aws",
  "summary": "Query AWS resources, CloudWatch logs and costs. Use for infrastructure inspection and spend review.",
  "category": "Cloud & DevOps",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "@aws/mcp-server-aws"
    ]
  },
  "auth": "apiKey",
  "scopes": [
    "read"
  ],
  "tools": [
    {
      "name": "list_resources",
      "description": "Lists resources of a given type in a region.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "description": "Service, e.g. ec2, s3, lambda."
          },
          "region": {
            "type": "string",
            "description": "AWS region."
          }
        },
        "required": [
          "service"
        ]
      },
      "readOnly": true
    },
    {
      "name": "query_logs",
      "description": "Runs a CloudWatch Logs Insights query.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "log_group": {
            "type": "string",
            "description": "Log group name."
          },
          "query": {
            "type": "string",
            "description": "Insights query string."
          }
        },
        "required": [
          "log_group",
          "query"
        ]
      },
      "readOnly": true
    },
    {
      "name": "get_cost_summary",
      "description": "Returns cost broken down by service for a period.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "description": "ISO start date."
          },
          "end": {
            "type": "string",
            "description": "ISO end date."
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "readOnly": true
    }
  ],
  "license": "MIT",
  "homepage": "https://aws.amazon.com"
}
