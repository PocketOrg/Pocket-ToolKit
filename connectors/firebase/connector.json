{
  "$schema": "https://usepocket.net/schema/connector.json",
  "name": "firebase",
  "summary": "Query Firestore, inspect authentication users and manage Firebase storage. Use for app backend operations.",
  "category": "Cloud & DevOps",
  "author": "pocket",
  "transport": "stdio",
  "command": {
    "run": "npx",
    "args": [
      "-y",
      "firebase-mcp"
    ]
  },
  "auth": "apiKey",
  "scopes": [
    "read",
    "write"
  ],
  "tools": [
    {
      "name": "firestore_query",
      "description": "Queries a Firestore collection.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection path."
          },
          "where": {
            "type": "string",
            "description": "Filter as JSON."
          },
          "limit": {
            "type": "number",
            "description": "Maximum documents."
          }
        },
        "required": [
          "collection"
        ]
      },
      "readOnly": true
    },
    {
      "name": "get_user",
      "description": "Returns an authentication user by uid or email.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "User uid or email address."
          }
        },
        "required": [
          "identifier"
        ]
      },
      "readOnly": true
    },
    {
      "name": "list_storage_files",
      "description": "Lists files in a storage bucket path.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path prefix."
          }
        },
        "required": []
      },
      "readOnly": true
    }
  ],
  "license": "MIT",
  "homepage": "https://firebase.google.com"
}
